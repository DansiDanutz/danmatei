# =============================================================================
# Școala de Fotbal Dan Matei — environment template
# Copy this to `.env.local` and fill in real values from your Supabase project.
#
# For Vercel production: `vercel env add <NAME> production` per variable, or
# use the Vercel dashboard. Variables marked REQUIRED-PROD fail closed in
# production/preview when the relevant route or cron is called.
# =============================================================================

# --- Supabase (browser + server) ---------------------------------------------
# Anon key is safe to ship to the browser; service role is server-only.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Server-only: NEVER prefix with VITE_, NEVER expose to the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...same-as-above...
SUPABASE_SERVICE_ROLE=eyJhbGciOi...service-role-key-keep-secret...

# --- App config --------------------------------------------------------------
# Origin used for password-reset / invite redirects and generated assistant links.
VITE_APP_URL=http://localhost:3030
# Optional legacy alias read by the ElevenLabs helper if VITE_APP_URL is absent.
NEXT_PUBLIC_APP_URL=http://localhost:3030

# --- Vercel Crons (REQUIRED-PROD for the cron endpoints) --------------------
# Vercel auto-injects `Authorization: Bearer ${CRON_SECRET}` on every cron
# request configured in vercel.json. Cron endpoints fail-closed: missing or
# wrong secret -> 503 in prod/preview, 401 if mismatched.
# Generate with: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CRON_SECRET=

# --- Web Push (VAPID) -------------------------------------------------------
# Used by api/push/{subscribe,vapid-key} + api/_lib/push.ts to send the
# inbox-blurred-tab + training-recap + birthday + RSVP pushes.
# Generate with: `npx web-push generate-vapid-keys --json`
# Subject can be `mailto:` or an https URL identifying the app owner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:semebitcoin@gmail.com

# --- OpenAI-compat (REQUIRED-PROD for LLM endpoints) ------------------------
# Used by api/training/recap-generate, api/lead/reply-draft,
# api/news/draft-weekly. Compatible with Gemini via OpenAI-compat URL.
# Point at api.openai.com for GPT, or
# https://generativelanguage.googleapis.com/v1beta/openai for Gemini.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- ElevenLabs Conversational AI -------------------------------------------
# Server-only. Used by /api/ai/start-conversation and /api/ai/webhook.
# Get the key from https://elevenlabs.io/app/settings/api-keys
# Default agent ID: the academy-wide assistant used when a trainer hasn't
# been linked to a specific agent. Each trainer can override via
# trainers.elevenlabs_agent_id (set from /admin or /antrenor).
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_DEFAULT_AGENT_ID=agent_...
# REQUIRED-PROD for /api/ai/webhook and /api/voice/elevenlabs-webhook — the
# HMAC secret ElevenLabs shows when you create the post-call webhook, so
# production/preview deployments can reject spoofed payloads.
ELEVENLABS_WEBHOOK_SECRET=
# The AI interview agent (Andra) used by /api/voice/start. Created/updated by
# `node scripts/elevenlabs-agent.mjs` from services/elevenlabs-agent/.
ELEVENLABS_INTERVIEW_AGENT_ID=

# --- WhatsApp Business Cloud API --------------------------------------------
# Server-only. Used by /api/whatsapp/send-welcome.
# Get these from Meta Business Manager → WhatsApp → Configuration.
# WHATSAPP_PHONE_ID is the numeric phone-number id, NOT the phone number.
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- AI-call lead flow (ElevenLabs interview + Evolution API) ---------------
# See docs/OPERATIONALIZE.md for the full deploy guide.

# Signs the /apel/<token> links. REQUIRED-PROD for the AI-call lead flow:
# api/lead/create and api/voice/start return 503 if missing in production.
# Generate with: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
LEAD_LINK_SIGNING_SECRET=

# WhatsApp via Evolution API (open-source, self-hosted). Preferred over Meta.
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=academia

# Public site URL Evolution API posts inbound WhatsApp messages to
# (docker-compose.yml → WEBHOOK_GLOBAL_URL).
API_BASE=https://www.danmatei.ro

# Trainer phones (optional) for the WhatsApp summary fan-out
TRAINER_PHONE_T_SOPI=
TRAINER_PHONE_T_KELEMEN=
TRAINER_PHONE_T_DAN=

# Caddy public host (optional, for TLS on the WhatsApp stack)
PUBLIC_HOST=
PUBLIC_BASE_URL=https://www.danmatei.ro
